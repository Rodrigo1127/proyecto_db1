@page "/departamentos"
@using Hospital.Interop.Web.Services
@inject DepartamentosService DepartamentosService
@inject NavigationManager Navigation

<div class="container-fluid mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="display-4">
                <i class="fas fa-hospital"></i> Departamentos
            </h1>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @mensajeError
            <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
        </div>
    }

    @if (cargandoDepartamentos)
    {
        <div class="text-center py-5">
            <i class="fas fa-spinner fa-spin fa-2x"></i>
            <p class="mt-3">Cargando departamentos...</p>
        </div>
    }
    else if (departamentos == null || departamentos.Count == 0)
    {
        <div class="alert alert-info text-center">
            <i class="fas fa-info-circle"></i> No hay departamentos registrados
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var departamento in departamentos)
            {
                <div class="col-md-3 mb-4">
                    <div class="card h-100 border-0 shadow-sm cursor-pointer" @onclick="() => VerDetalles(departamento.Id)">
                        <div class="card-body">
                            <div class="text-center">
                                <i class="fas fa-hospital fa-3x text-info mb-3"></i>
                                <h5 class="card-title">@departamento.Nombre</h5>
                                <p class="text-muted">@departamento.Descripcion</p>
                                <span class="badge bg-info">@departamento.PacientesCount pacientes</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="row mt-5">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <h5>Información General de Departamentos</h5>
                        <button class="btn btn-sm btn-primary" @onclick="MostrarFormularioNuevo">
                            <i class="fas fa-plus"></i> Nuevo Departamento
                        </button>
                    </div>

                    @if (mostrarFormulario)
                    {
                        <div class="card-body border-bottom">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Nombre</label>
                                    <input type="text" class="form-control" placeholder="Nombre del departamento" @bind="nuevoDepartamento.Nombre" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Descripción</label>
                                    <input type="text" class="form-control" placeholder="Descripción" @bind="nuevoDepartamento.Descripcion" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <button class="btn btn-primary" @onclick="GuardarDepartamento" disabled="@estaCargando">
                                        @if (estaCargando)
                                        {
                                            <i class="fas fa-spinner fa-spin"></i> <span>Guardando...</span>
                                        }
                                        else
                                        {
                                            <i class="fas fa-save"></i> <span>Guardar</span>
                                        }
                                    </button>
                                    <button class="btn btn-secondary" @onclick="CancelarFormulario">
                                        <i class="fas fa-times"></i> Cancelar
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Departamento</th>
                                        <th>Descripción</th>
                                        <th>Pacientes</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var departamento in departamentos)
                                    {
                                        <tr>
                                            <td><strong>@departamento.Nombre</strong></td>
                                            <td>@departamento.Descripcion</td>
                                            <td>@departamento.PacientesCount</td>
                                            <td>
                                                <button class="btn btn-sm btn-info" @onclick="() => VerDetalles(departamento.Id)">
                                                    <i class="fas fa-eye"></i> Ver
                                                </button>
                                                <button class="btn btn-sm btn-warning" @onclick="() => EditarDepartamento(departamento)">
                                                    <i class="fas fa-edit"></i> Editar
                                                </button>
                                                <button class="btn btn-sm btn-danger" @onclick="() => EliminarDepartamento(departamento.Id)">
                                                    <i class="fas fa-trash"></i> Eliminar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<DepartamentosService.DepartamentoDTO> departamentos = new();
    private DepartamentosService.DepartamentoDTO nuevoDepartamento = new();
    private bool mostrarFormulario = false;
    private bool cargandoDepartamentos = true;
    private bool estaCargando = false;
    private string mensajeError = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarDepartamentos();
    }

    private async Task CargarDepartamentos()
    {
        cargandoDepartamentos = true;
        departamentos = await DepartamentosService.ObtenerDepartamentos();
        cargandoDepartamentos = false;
    }

    private void MostrarFormularioNuevo()
    {
        mostrarFormulario = true;
        nuevoDepartamento = new();
    }

    private void EditarDepartamento(DepartamentosService.DepartamentoDTO departamento)
    {
        mostrarFormulario = true;
        nuevoDepartamento = new DepartamentosService.DepartamentoDTO
        {
            Id = departamento.Id,
            Nombre = departamento.Nombre,
            Descripcion = departamento.Descripcion
        };
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
        nuevoDepartamento = new();
    }

    private async Task GuardarDepartamento()
    {
        estaCargando = true;

        if (string.IsNullOrWhiteSpace(nuevoDepartamento.Nombre))
        {
            mensajeError = "El nombre del departamento es requerido";
            estaCargando = false;
            return;
        }

        bool exitoso;

        if (nuevoDepartamento.Id > 0)
        {
            exitoso = await DepartamentosService.ActualizarDepartamento(nuevoDepartamento.Id, nuevoDepartamento);
        }
        else
        {
            exitoso = await DepartamentosService.CrearDepartamento(nuevoDepartamento);
        }

        if (exitoso)
        {
            mostrarFormulario = false;
            nuevoDepartamento = new();
            await CargarDepartamentos();
        }
        else
        {
            mensajeError = "Error al guardar el departamento";
        }

        estaCargando = false;
    }

    private async Task EliminarDepartamento(int id)
    {
        if (await DepartamentosService.EliminarDepartamento(id))
        {
            await CargarDepartamentos();
        }
        else
        {
            mensajeError = "Error al eliminar el departamento";
        }
    }

    private void VerDetalles(int id)
    {
        Navigation.NavigateTo($"/departamentos/{id}");
    }
}
