@page "/pacientes"
@inject PacienteService PacienteService
@using Hospital.Interop.Web.Models
@using PacienteModel = Hospital.Interop.Web.Models.Paciente

<PageTitle>Pacientes - Hospital Interop</PageTitle>

<div class="animate-fade-in">
    <!-- Header -->
    <div class="row mb-5 align-items-center">
        <div class="col-md-6">
            <h1 class="display-6 fw-bold mb-1">Directorio de Pacientes</h1>
            <p class="text-secondary lead mb-0">Gestione el historial y registros médicos centrales.</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <button class="btn btn-primary btn-lg shadow-md" @onclick="MostrarFormularioNuevo">
                <i class="fas fa-plus-circle me-2"></i>Registrar Paciente
            </button>
        </div>
    </div>

    <!-- Alert Messaging -->
    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success border-0 shadow-sm mb-4 d-flex align-items-center p-3 animate-fade-in" style="border-radius: 0.75rem;">
            <i class="fas fa-check-circle fa-lg me-3"></i>
            <div class="flex-grow-1 fw-medium">@mensajeExito</div>
            <button type="button" class="btn-close" @onclick="() => mensajeExito = null"></button>
        </div>
    }

    <!-- Form Section -->
    @if (mostrarFormulario)
    {
        <div class="card border-0 shadow-lg mb-5 animate-fade-in">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">
                    <i class="fas @(nuevoPaciente.PacienteId > 0 ? "fa-user-edit" : "fa-user-plus") text-primary me-2"></i>
                    @(nuevoPaciente.PacienteId > 0 ? "Editar Expediente" : "Nuevo Registro")
                </h5>
                <button class="btn btn-light btn-sm rounded-circle" @onclick="CancelarFormulario"><i class="fas fa-times"></i></button>
            </div>
            <div class="card-body p-4 p-md-5">
                <EditForm Model="@nuevoPaciente" OnValidSubmit="GuardarPaciente">
                    <DataAnnotationsValidator />
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label text-uppercase small fw-bold text-muted mb-2">Nombre Completo</label>
                            <InputText @bind-Value="nuevoPaciente.Nombre" class="form-control" placeholder="Nombre completo del paciente" />
                            <ValidationMessage For="@(() => nuevoPaciente.Nombre)" class="text-danger small" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-uppercase small fw-bold text-muted mb-2">Documento Identidad</label>
                            <InputText @bind-Value="nuevoPaciente.Documento" class="form-control" placeholder="DNI / Pasaporte / CUI" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-uppercase small fw-bold text-muted mb-2">Correo Electrónico</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fas fa-envelope text-muted"></i></span>
                                <InputText @bind-Value="nuevoPaciente.Email" class="form-control border-start-0" placeholder="ejemplo@correo.com" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-uppercase small fw-bold text-muted mb-2">Teléfono de Contacto</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fas fa-phone text-muted"></i></span>
                                <InputText @bind-Value="nuevoPaciente.Telefono" class="form-control border-start-0" placeholder="+502 XXXX XXXX" />
                            </div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label text-uppercase small fw-bold text-muted mb-2">Dirección de Residencia</label>
                            <InputTextArea @bind-Value="nuevoPaciente.Direccion" class="form-control" rows="2" placeholder="Dirección completa..." />
                        </div>
                    </div>
                    <div class="mt-5 pt-3 d-flex justify-content-end gap-3">
                        <button type="button" class="btn btn-light px-4" @onclick="CancelarFormulario">Descartar</button>
                        <button type="submit" class="btn btn-primary px-5 shadow-sm" disabled="@estaCargando">
                            @if (estaCargando)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span><span>Procesando...</span>
                            }
                            else
                            {
                                <i class="fas fa-save me-2"></i><span>Confirmar y Guardar</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- Search & Filter -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <div class="col-lg-6">
                    <div class="input-group shadow-sm" style="border-radius: var(--radius-md); overflow: hidden;">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" class="form-control border-start-0 ps-0" placeholder="Buscar por nombre o documento..." @bind="textoBusqueda" @bind:event="oninput" @onkeyup="@BuscarPacientes" />
                    </div>
                </div>
                <div class="col-lg-6 text-lg-end">
                    <button class="btn btn-outline-secondary px-4" @onclick="MostrarTodos">
                        <i class="fas fa-sync-alt me-2"></i>Actualizar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Paciente</th>
                        <th>Documento</th>
                        <th>Contacto</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Gestión</th>
                    </tr>
                </thead>
                <tbody>
                    @if (cargandoPacientes)
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="spinner-grow text-primary" role="status"></div>
                                <div class="mt-3 text-muted fw-medium">Sincronizando registros...</div>
                            </td>
                        </tr>
                    }
                    else if (pacientes == null || !pacientes.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="opacity-25 mb-3">
                                    <i class="fas fa-user-friends fa-4x"></i>
                                </div>
                                <h5 class="text-muted fw-bold">No hay resultados</h5>
                                <p class="text-muted small">Intente con otro criterio de búsqueda.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var paciente in pacientes)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                            <i class="fas fa-user"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-secondary">@paciente.Nombre</div>
                                            <div class="small text-muted">Exp: #@paciente.PacienteId</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="fw-medium">@paciente.Documento</span></td>
                                <td>
                                    <div class="small fw-bold">@paciente.Email</div>
                                    <div class="small text-muted"><i class="fas fa-phone-alt me-1"></i> @paciente.Telefono</div>
                                </td>
                                <td>
                                    <span class="badge @(paciente.Activo ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                        @(paciente.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="dropdown">
                                        <button class="btn btn-light btn-sm border shadow-sm" type="button" data-bs-toggle="dropdown">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                            <li><button class="dropdown-item py-2" @onclick="() => VerPaciente(paciente)"><i class="fas fa-eye text-info me-2"></i> Ver Detalle</button></li>
                                            <li><button class="dropdown-item py-2" @onclick="() => EditarPaciente(paciente)"><i class="fas fa-edit text-warning me-2"></i> Editar</button></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><button class="dropdown-item py-2 text-danger" @onclick="() => EliminarPaciente(paciente.PacienteId)"><i class="fas fa-trash-alt me-2"></i> Dar de Baja</button></li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .bg-success-subtle { background-color: #d1fae5; color: #065f46; }
    .bg-danger-subtle { background-color: #fee2e2; color: #991b1b; }
    .dropdown-item:active { background-color: var(--primary); }
</style>

@code {
    private List<PacienteModel> pacientes = new();
    private PacienteModel nuevoPaciente = new PacienteModel();
    private string textoBusqueda = "";

    private bool mostrarFormulario = false;
    private bool cargandoPacientes = true;
    private bool estaCargando = false;

    private string? mensajeError;
    private string? mensajeExito;

    protected override async Task OnInitializedAsync()
    {
        await CargarPacientes();
    }

    private async Task CargarPacientes()
    {
        cargandoPacientes = true;
        try {
            pacientes = await PacienteService.ObtenerTodosPacientes();
        } catch {
            pacientes = new List<PacienteModel>();
        }
        cargandoPacientes = false;
    }

    private async Task BuscarPacientes()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda))
        {
            await CargarPacientes();
            return;
        }

        cargandoPacientes = true;
        pacientes = await PacienteService.BuscarPacientes(textoBusqueda);
        cargandoPacientes = false;
    }

    private async Task MostrarTodos()
    {
        textoBusqueda = "";
        await CargarPacientes();
    }

    private void MostrarFormularioNuevo()
    {
        nuevoPaciente = new PacienteModel { FechaRegistro = DateTime.UtcNow, Activo = true };
        mensajeError = null;
        mensajeExito = null;
        mostrarFormulario = true;
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
        mensajeError = null;
        mensajeExito = null;
    }

    private void VerPaciente(PacienteModel paciente)
    {
        mensajeExito = $"Vista previa de: {paciente.Nombre} (Exp # {paciente.PacienteId})";
    }

    private void EditarPaciente(PacienteModel paciente)
    {
        nuevoPaciente = new PacienteModel
        {
            PacienteId = paciente.PacienteId,
            Nombre = paciente.Nombre,
            Documento = paciente.Documento,
            Email = paciente.Email,
            Telefono = paciente.Telefono,
            Direccion = paciente.Direccion,
            FechaNacimiento = paciente.FechaNacimiento,
            Genero = paciente.Genero,
            FechaRegistro = paciente.FechaRegistro,
            Activo = paciente.Activo
        };
        mostrarFormulario = true;
    }

    private async Task EliminarPaciente(int id)
    {
        estaCargando = true;
        var exito = await PacienteService.EliminarPaciente(id);
        if (exito) {
            mensajeExito = "Registro desactivado correctamente.";
            await CargarPacientes();
        }
        estaCargando = false;
    }

    private async Task GuardarPaciente()
    {
        estaCargando = true;
        bool exito;
        if (nuevoPaciente.PacienteId > 0)
            exito = await PacienteService.ActualizarPaciente(nuevoPaciente.PacienteId, nuevoPaciente);
        else
            exito = await PacienteService.CrearPaciente(nuevoPaciente);

        if (exito)
        {
            mensajeExito = "Operación completada con éxito.";
            mostrarFormulario = false;
            await CargarPacientes();
        }
        estaCargando = false;
    }
}
