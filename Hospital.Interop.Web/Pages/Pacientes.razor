@page "/pacientes"
@using Hospital.Interop.Web.Services
@using Hospital.Interop.Web.Models
@using PacienteModel = Hospital.Interop.Web.Models.Paciente
@inject PacienteService PacienteService
@inject NavigationManager Navigation

<div class="container-fluid mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="display-4">
                <i class="fas fa-users"></i> Gestión de Pacientes
            </h1>
        </div>
        <div class="col-md-4 text-end">
            <button class="btn btn-primary btn-lg" @onclick="MostrarFormularioNuevo">
                <i class="fas fa-plus"></i> Nuevo Paciente
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @mensajeError
            <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @mensajeExito
            <button type="button" class="btn-close" @onclick="() => mensajeExito = null"></button>
        </div>
    }

    @if (mostrarFormulario)
    {
        <div class="card mb-4 border-primary">
            <div class="card-header bg-primary text-white">
                <h5>
                    @(nuevoPaciente.PacienteId > 0 ? "Editar Paciente" : "Registrar Nuevo Paciente")
                </h5>
            </div>

            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nombre</label>
                        <input type="text" class="form-control" placeholder="Nombre del paciente" @bind="nuevoPaciente.Nombre" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Documento (Cédula)</label>
                        <input type="text" class="form-control" placeholder="Cédula" @bind="nuevoPaciente.Documento" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" placeholder="correo@ejemplo.com" @bind="nuevoPaciente.Email" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Teléfono</label>
                        <input type="tel" class="form-control" placeholder="+591 XXX XXX XX" @bind="nuevoPaciente.Telefono" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Dirección</label>
                        <input type="text" class="form-control" placeholder="Dirección del paciente" @bind="nuevoPaciente.Direccion" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Fecha de Nacimiento</label>
                        <input type="date" class="form-control" @bind="nuevoPaciente.FechaNacimiento" />
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-12">
                        <button class="btn btn-success" @onclick="GuardarPaciente" disabled="@estaCargando">
                            @if (estaCargando)
                            {
                                <span><i class="fas fa-spinner fa-spin"></i> Guardando...</span>
                            }
                            else
                            {
                                <span><i class="fas fa-save"></i> @(nuevoPaciente.PacienteId > 0 ? "Actualizar" : "Guardar")</span>
                            }
                        </button>

                        <button class="btn btn-secondary ms-2" @onclick="CancelarFormulario">
                            <i class="fas fa-times"></i> Cancelar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-light">
                    <div class="row align-items-center">
                        <div class="col-6">
                            <h5>Lista de Pacientes</h5>
                        </div>
                        <div class="col-6">
                            <div class="input-group">
                                <input type="text" class="form-control" placeholder="Buscar por nombre..." @bind="textoBusqueda" />
                                <button class="btn btn-outline-secondary" type="button" @onclick="BuscarPacientes">
                                    <i class="fas fa-search"></i> Buscar
                                </button>
                                <button class="btn btn-outline-secondary" type="button" @onclick="MostrarTodos">
                                    <i class="fas fa-times"></i> Limpiar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div class="table-responsive">
                        @if (cargandoPacientes)
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-spinner fa-spin fa-2x"></i>
                                <p class="mt-3">Cargando datos...</p>
                            </div>
                        }
                        else if (pacientes == null || pacientes.Count == 0)
                        {
                            <div class="alert alert-info text-center">
                                <i class="fas fa-info-circle"></i> No hay pacientes registrados
                            </div>
                        }
                        else
                        {
                            <table class="table table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Nombre</th>
                                        <th>Documento</th>
                                        <th>Email</th>
                                        <th>Teléfono</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var paciente in pacientes)
                                    {
                                        <tr>
                                            <td>@paciente.PacienteId</td>
                                            <td>@paciente.Nombre</td>
                                            <td>@paciente.Documento</td>
                                            <td>@paciente.Email</td>
                                            <td>@paciente.Telefono</td>
                                            <td>
                                                <button class="btn btn-sm btn-info" title="Ver detalles" @onclick="() => VerPaciente(paciente)">
                                                    <i class="fas fa-eye"></i> Ver
                                                </button>

                                                <button class="btn btn-sm btn-warning" title="Editar" @onclick="() => EditarPaciente(paciente)">
                                                    <i class="fas fa-edit"></i> Editar
                                                </button>

                                                <button class="btn btn-sm btn-danger" title="Eliminar" @onclick="() => EliminarPaciente(paciente.PacienteId)">
                                                    <i class="fas fa-trash"></i> Eliminar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<PacienteModel> pacientes = new();
    private PacienteModel nuevoPaciente = new PacienteModel();
    private string textoBusqueda = "";

    private bool mostrarFormulario = false;
    private bool cargandoPacientes = true;
    private bool estaCargando = false;

    private string? mensajeError;
    private string? mensajeExito;

    protected override async Task OnInitializedAsync()
    {
        await CargarPacientes();
    }

    private async Task CargarPacientes()
    {
        cargandoPacientes = true;
        var resultado = await PacienteService.ObtenerTodosPacientes();
        pacientes = resultado ?? new List<PacienteModel>();
        cargandoPacientes = false;
    }

    private async Task BuscarPacientes()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda))
        {
            await CargarPacientes();
            return;
        }

        cargandoPacientes = true;
        var resultado = await PacienteService.BuscarPacientes(textoBusqueda);
        pacientes = resultado ?? new List<PacienteModel>();
        cargandoPacientes = false;
    }

    private async Task MostrarTodos()
    {
        textoBusqueda = "";
        await CargarPacientes();
    }

    private void MostrarFormularioNuevo()
    {
        nuevoPaciente = new PacienteModel
        {
            FechaRegistro = DateTime.UtcNow,
            Activo = true
        };

        mensajeError = null;
        mensajeExito = null;
        mostrarFormulario = true;
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
        nuevoPaciente = new PacienteModel
        {
            FechaRegistro = DateTime.UtcNow,
            Activo = true
        };
        mensajeError = null;
        mensajeExito = null;
    }

    private void VerPaciente(PacienteModel paciente)
    {
        mensajeExito = $"Paciente: {paciente.Nombre} | Documento: {paciente.Documento} | Teléfono: {paciente.Telefono}";
        mensajeError = null;
    }

    private void EditarPaciente(PacienteModel paciente)
    {
        nuevoPaciente = new PacienteModel
        {
            PacienteId = paciente.PacienteId,
            Nombre = paciente.Nombre,
            Documento = paciente.Documento,
            Email = paciente.Email,
            Telefono = paciente.Telefono,
            Direccion = paciente.Direccion,
            FechaNacimiento = paciente.FechaNacimiento,
            Genero = paciente.Genero,
            FechaRegistro = paciente.FechaRegistro,
            Activo = paciente.Activo
        };

        mostrarFormulario = true;
        mensajeError = null;
        mensajeExito = "Editando paciente seleccionado.";
    }

    private async Task EliminarPaciente(int id)
    {
        estaCargando = true;
        mensajeError = null;
        mensajeExito = null;

        try
        {
            var eliminado = await PacienteService.EliminarPaciente(id);

            if (eliminado)
            {
                mensajeExito = "Paciente eliminado correctamente.";
                await CargarPacientes();
            }
            else
            {
                mensajeError = "No se pudo eliminar el paciente.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al eliminar: {ex.Message}";
        }
        finally
        {
            estaCargando = false;
        }
    }

    private async Task GuardarPaciente()
    {
        if (string.IsNullOrWhiteSpace(nuevoPaciente.Nombre))
        {
            mensajeError = "El nombre del paciente es requerido.";
            return;
        }

        if (string.IsNullOrWhiteSpace(nuevoPaciente.Email))
        {
            mensajeError = "El email es requerido.";
            return;
        }

        estaCargando = true;
        mensajeError = null;
        mensajeExito = null;

        try
        {
            bool resultado;

            if (nuevoPaciente.PacienteId > 0)
            {
                resultado = await PacienteService.ActualizarPaciente(nuevoPaciente.PacienteId, nuevoPaciente);
            }
            else
            {
                resultado = await PacienteService.CrearPaciente(nuevoPaciente);
            }

            if (resultado)
            {
                mensajeExito = nuevoPaciente.PacienteId > 0
                    ? "Paciente actualizado correctamente."
                    : "Paciente guardado correctamente.";

                nuevoPaciente = new PacienteModel
                {
                    FechaRegistro = DateTime.UtcNow,
                    Activo = true
                };

                mostrarFormulario = false;
                await CargarPacientes();
            }
            else
            {
                mensajeError = "No se pudo guardar el paciente. Revise la consola o Swagger.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error: {ex.Message}";
        }
        finally
        {
            estaCargando = false;
        }
    }
}
