@page "/facturacion"
@inject FacturacionService FacturacionService
@inject PacienteService PacienteService
@using Hospital.Interop.Web.Models
@using PacienteModel = Hospital.Interop.Web.Models.Paciente

<PageTitle>Facturación - Hospital Interop</PageTitle>

<div class="animate-fade-in">
    <!-- Header -->
    <div class="row mb-5 align-items-center">
        <div class="col-md-6">
            <h1 class="display-6 fw-bold mb-1">Facturación y Pagos</h1>
            <p class="text-secondary lead mb-0">Control financiero y gestión de comprobantes.</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <button class="btn btn-primary btn-lg shadow-md" @onclick="MostrarNuevo">
                <i class="fas fa-file-invoice-dollar me-2"></i>Generar Factura
            </button>
        </div>
    </div>

    <!-- Stats -->
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card p-3 border-0 shadow-sm bg-white h-100">
                <div class="text-muted small fw-bold text-uppercase mb-2">Total Recaudado</div>
                <div class="h3 fw-bold text-primary mb-0">$ @facturas?.Where(f => f.Estado == "Pagada").Sum(f => f.Monto).ToString("N2")</div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card p-3 border-0 shadow-sm bg-white h-100">
                <div class="text-muted small fw-bold text-uppercase mb-2">Pendiente Cobro</div>
                <div class="h3 fw-bold text-warning mb-0">$ @facturas?.Where(f => f.Estado == "Pendiente").Sum(f => f.Monto).ToString("N2")</div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card p-3 border-0 shadow-sm bg-white h-100">
                <div class="text-muted small fw-bold text-uppercase mb-2">Facturas Pagadas</div>
                <div class="h3 fw-bold text-success mb-0">@facturas?.Count(f => f.Estado == "Pagada")</div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card p-3 border-0 shadow-sm bg-white h-100">
                <div class="text-muted small fw-bold text-uppercase mb-2">Pacientes Atendidos</div>
                <div class="h3 fw-bold text-info mb-0">@facturas?.Select(f => f.PacienteId).Distinct().Count()</div>
            </div>
        </div>
    </div>

    <!-- Form -->
    @if (mostrarFormulario)
    {
        <div class="card border-0 shadow-lg mb-5 animate-fade-in">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="fw-bold mb-0">Nueva Emisión de Factura</h5>
            </div>
            <div class="card-body p-4 p-md-5">
                <EditForm Model="@nuevaFactura" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted small text-uppercase">Paciente</label>
                            <InputSelect @bind-Value="nuevaFactura.PacienteId" class="form-select">
                                <option value="0">-- Seleccione Paciente --</option>
                                @if (pacientes != null)
                                {
                                    @foreach (var p in pacientes)
                                    {
                                        <option value="@p.PacienteId">@p.Nombre (@p.Documento)</option>
                                    }
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted small text-uppercase">Monto ($)</label>
                            <InputNumber @bind-Value="nuevaFactura.Monto" class="form-control" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold text-muted small text-uppercase">Concepto / Servicio</label>
                            <InputText @bind-Value="nuevaFactura.Concepto" class="form-control" placeholder="Ej: Consulta Médica General" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-muted small text-uppercase">Método de Pago</label>
                            <InputSelect @bind-Value="nuevaFactura.MetodoPago" class="form-select">
                                <option value="Efectivo">Efectivo</option>
                                <option value="Tarjeta">Tarjeta de Crédito/Débito</option>
                                <option value="Seguro">Seguro Médico</option>
                                <option value="Transferencia">Transferencia</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-muted small text-uppercase">Estado</label>
                            <InputSelect @bind-Value="nuevaFactura.Estado" class="form-select">
                                <option value="Pendiente">Pendiente</option>
                                <option value="Pagada">Pagada</option>
                                <option value="Anulada">Anulada</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-muted small text-uppercase">Fecha Factura</label>
                            <InputDate @bind-Value="nuevaFactura.FechaFactura" class="form-control" />
                        </div>
                    </div>
                    <div class="mt-4 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-light px-4" @onclick="() => mostrarFormulario = false">Cerrar</button>
                        <button type="submit" class="btn btn-dark px-5 shadow-sm">
                            <i class="fas fa-print me-2"></i>Emitir Comprobante
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- Table -->
    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">No. Factura</th>
                        <th>Paciente ID</th>
                        <th>Fecha</th>
                        <th>Monto</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (facturas == null)
                    {
                        <tr><td colspan="6" class="text-center py-5"><div class="spinner-border text-primary"></div></td></tr>
                    }
                    else
                    {
                        @foreach (var factura in facturas)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-primary">#FAC-@factura.FacturaId.ToString("D5")</div>
                                    <div class="small text-muted">@factura.MetodoPago</div>
                                </td>
                                <td><span class="fw-bold">@factura.PacienteId</span></td>
                                <td>@factura.FechaFactura.ToShortDateString()</td>
                                <td><span class="fw-bold text-dark">$ @factura.Monto.ToString("N2")</span></td>
                                <td>
                                    <span class="badge @(factura.Estado == "Pagada" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning")">
                                        @factura.Estado
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-light border"><i class="fas fa-file-pdf text-danger"></i></button>
                                    <button class="btn btn-sm btn-light border ms-1"><i class="fas fa-print"></i></button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .bg-success-subtle { background-color: #dcfce7; color: #166534; }
    .bg-warning-subtle { background-color: #fef3c7; color: #92400e; }
</style>

@code {
    private List<Factura> facturas;
    private List<PacienteModel> pacientes;
    private Factura nuevaFactura = new Factura();
    private bool mostrarFormulario = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        facturas = await FacturacionService.ObtenerTodasFacturas();
        pacientes = await PacienteService.ObtenerTodosPacientes();
    }

    private void MostrarNuevo()
    {
        nuevaFactura = new Factura { FechaFactura = DateTime.Today, Estado = "Pendiente", MetodoPago = "Efectivo" };
        mostrarFormulario = true;
    }

    private async Task Guardar()
    {
        if (await FacturacionService.CrearFactura(nuevaFactura))
        {
            mostrarFormulario = false;
            await CargarDatos();
        }
    }
}
