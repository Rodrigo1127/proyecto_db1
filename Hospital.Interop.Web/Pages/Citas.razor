@page "/citas"
@using Hospital.Interop.Web.Services
@inject CitasService CitasService
@inject NavigationManager Navigation

<div class="container-fluid mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="display-4">
                <i class="fas fa-calendar-alt"></i> Gestión de Citas
            </h1>
        </div>
        <div class="col-md-4 text-end">
            <button class="btn btn-success btn-lg" @onclick="MostrarFormularioNuevo">
                <i class="fas fa-plus"></i> Nueva Cita
            </button>
        </div>
    </div>

    @if (mostrarFormulario)
    {
        <div class="card mb-4 border-success">
            <div class="card-header bg-success text-white">
                <h5>Agendar Nueva Cita</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Paciente</label>
                        <input type="text" class="form-control" placeholder="Seleccionar paciente" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Departamento</label>
                        <select class="form-select">
                            <option selected>Seleccionar departamento...</option>
                            <option value="1">Cardiología</option>
                            <option value="2">Oftalmología</option>
                            <option value="3">Dermatología</option>
                            <option value="4">Pediatría</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Fecha</label>
                        <input type="date" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Hora</label>
                        <input type="time" class="form-control" />
                    </div>
                    <div class="col-12 mb-3">
                        <label class="form-label">Observaciones</label>
                        <textarea class="form-control" rows="3" placeholder="Notas adicionales"></textarea>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-12">
                        <button class="btn btn-success" @onclick="GuardarCita">
                            <i class="fas fa-save"></i> Guardar Cita
                        </button>
                        <button class="btn btn-secondary" @onclick="CancelarFormulario">
                            <i class="fas fa-times"></i> Cancelar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5>Próximas Citas</h5>
                    <input type="search" class="form-control" style="width: 250px;" placeholder="Buscar cita..." />
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <div class="card border-left-success">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h6>Juan Pérez</h6>
                                            <p class="text-muted mb-0">Cardiología</p>
                                        </div>
                                        <span class="badge bg-success">Confirmada</span>
                                    </div>
                                    <div class="mt-3">
                                        <small class="text-muted">
                                            <i class="fas fa-calendar"></i> 15/01/2024 - 10:30 AM
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card border-left-warning">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h6>María García</h6>
                                            <p class="text-muted mb-0">Pediatría</p>
                                        </div>
                                        <span class="badge bg-warning">Pendiente</span>
                                    </div>
                                    <div class="mt-3">
                                        <small class="text-muted">
                                            <i class="fas fa-calendar"></i> 16/01/2024 - 02:00 PM
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card border-left-danger">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <h6>Carlos López</h6>
                                            <p class="text-muted mb-0">Oftalmología</p>
                                        </div>
                                        <span class="badge bg-danger">Cancelada</span>
                                    </div>
                                    <div class="mt-3">
                                        <small class="text-muted">
                                            <i class="fas fa-calendar"></i> 17/01/2024 - 11:00 AM
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .border-left-success {
        border-left: 4px solid #28a745 !important;
    }
    .border-left-warning {
        border-left: 4px solid #ffc107 !important;
    }
    .border-left-danger {
        border-left: 4px solid #dc3545 !important;
    }
</style>

@code {
    private bool mostrarFormulario = false;

    private void MostrarFormularioNuevo()
    {
        mostrarFormulario = true;
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
    }

    private async Task GuardarCita()
    {
        mostrarFormulario = false;
    }
}
