@page "/citas"
@inject CitasService CitasService
@inject PacienteService PacienteService
@using Hospital.Interop.Web.Models
@using PacienteModel = Hospital.Interop.Web.Models.Paciente

<PageTitle>Citas Médicas - Hospital Interop</PageTitle>

<div class="animate-fade-in">
    <!-- Header -->
    <div class="row mb-5 align-items-center">
        <div class="col-md-6">
            <h1 class="display-6 fw-bold mb-1">Agenda de Citas</h1>
            <p class="text-secondary lead mb-0">Gestión de turnos y disponibilidad por departamento.</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <button class="btn btn-primary btn-lg shadow-md" @onclick="MostrarNuevo">
                <i class="fas fa-calendar-plus me-2"></i>Nueva Cita
            </button>
        </div>
    </div>

    <!-- Stats for Citas -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card p-3 border-0 shadow-sm bg-white">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3">
                        <i class="fas fa-clock fa-lg"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Pendientes</div>
                        <div class="h4 fw-bold mb-0">@citas?.Count(c => c.Estado == "Pendiente")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3 border-0 shadow-sm bg-white">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-success bg-opacity-10 text-success p-3 rounded-3">
                        <i class="fas fa-check-double fa-lg"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Completadas</div>
                        <div class="h4 fw-bold mb-0">@citas?.Count(c => c.Estado == "Completada")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3 border-0 shadow-sm bg-white">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-danger bg-opacity-10 text-danger p-3 rounded-3">
                        <i class="fas fa-times-circle fa-lg"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Canceladas</div>
                        <div class="h4 fw-bold mb-0">@citas?.Count(c => c.Estado == "Cancelada")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Form Section -->
    @if (mostrarFormulario)
    {
        <div class="card border-0 shadow-lg mb-5 animate-fade-in">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="fw-bold mb-0"><i class="fas fa-calendar-alt me-2"></i>@(nuevaCita.Id > 0 ? "Editar Cita" : "Programar Nueva Cita")</h5>
            </div>
            <div class="card-body p-4 p-md-5">
                <EditForm Model="@nuevaCita" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted small text-uppercase">Paciente</label>
                            <InputSelect @bind-Value="nuevaCita.PacienteId" class="form-select">
                                <option value="0">-- Seleccione Paciente --</option>
                                @if (pacientes != null)
                                {
                                    @foreach (var p in pacientes)
                                    {
                                        <option value="@p.PacienteId">@p.Nombre (@p.Documento)</option>
                                    }
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted small text-uppercase">Departamento</label>
                            <InputSelect @bind-Value="nuevaCita.Departamento" class="form-select">
                                <option value="">-- Seleccione Area --</option>
                                <option value="Medicina General">Medicina General</option>
                                <option value="Pediatría">Pediatría</option>
                                <option value="Ginecología">Ginecología</option>
                                <option value="Odontología">Odontología</option>
                                <option value="Cardiología">Cardiología</option>
                                <option value="Laboratorio">Laboratorio</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-muted small text-uppercase">Fecha</label>
                            <InputDate @bind-Value="nuevaCita.Fecha" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-muted small text-uppercase">Hora</label>
                            <InputText @bind-Value="nuevaCita.Hora" class="form-control" placeholder="Ej: 09:30 AM" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-muted small text-uppercase">Estado</label>
                            <InputSelect @bind-Value="nuevaCita.Estado" class="form-select">
                                <option value="Pendiente">Pendiente</option>
                                <option value="Confirmada">Confirmada</option>
                                <option value="Completada">Completada</option>
                                <option value="Cancelada">Cancelada</option>
                            </InputSelect>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold text-muted small text-uppercase">Observaciones</label>
                            <InputTextArea @bind-Value="nuevaCita.Observaciones" class="form-control" rows="2" placeholder="Motivo de la consulta o notas adicionales..." />
                        </div>
                    </div>
                    <div class="mt-4 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-light px-4" @onclick="() => mostrarFormulario = false">Cancelar</button>
                        <button type="submit" class="btn btn-primary px-5 shadow-sm">
                            <i class="fas fa-check-circle me-2"></i>Guardar Cita
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- Table -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Paciente</th>
                        <th>Servicio</th>
                        <th>Fecha y Hora</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (citas == null)
                    {
                        <tr><td colspan="5" class="text-center py-5"><div class="spinner-border text-primary"></div></td></tr>
                    }
                    else if (!citas.Any())
                    {
                        <tr><td colspan="5" class="text-center py-5 text-muted">No hay citas registradas.</td></tr>
                    }
                    else
                    {
                        @foreach (var cita in citas)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-secondary">#@cita.PacienteId</div>
                                    <div class="small text-muted">Cita ID: @cita.Id</div>
                                </td>
                                <td><span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25">@cita.Departamento</span></td>
                                <td>
                                    <div class="fw-bold">@cita.Fecha.ToShortDateString()</div>
                                    <div class="small text-muted"><i class="far fa-clock me-1"></i> @cita.Hora</div>
                                </td>
                                <td>
                                    @switch (cita.Estado)
                                    {
                                        case "Pendiente": <span class="badge bg-warning-subtle text-warning"><i class="fas fa-spinner fa-spin me-1"></i> @cita.Estado</span> break;
                                        case "Confirmada": <span class="badge bg-primary-subtle text-primary"><i class="fas fa-check me-1"></i> @cita.Estado</span> break;
                                        case "Completada": <span class="badge bg-success-subtle text-success"><i class="fas fa-check-double me-1"></i> @cita.Estado</span> break;
                                        default: <span class="badge bg-danger-subtle text-danger">@cita.Estado</span> break;
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-light border" @onclick="() => Editar(cita)"><i class="fas fa-edit text-warning"></i></button>
                                    <button class="btn btn-sm btn-light border ms-1" @onclick="() => Eliminar(cita.Id)"><i class="fas fa-trash text-danger"></i></button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .bg-success-subtle { background-color: #dcfce7; color: #166534; }
    .bg-primary-subtle { background-color: #dbeafe; color: #1e40af; }
    .bg-warning-subtle { background-color: #fef3c7; color: #92400e; }
    .bg-danger-subtle { background-color: #fee2e2; color: #991b1b; }
</style>

@code {
    private List<Cita> citas;
    private List<PacienteModel> pacientes;
    private Cita nuevaCita = new Cita();
    private bool mostrarFormulario = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        citas = await CitasService.ObtenerTodasCitas();
        pacientes = await PacienteService.ObtenerTodosPacientes();
    }

    private void MostrarNuevo()
    {
        nuevaCita = new Cita { Fecha = DateTime.Today, Estado = "Pendiente" };
        mostrarFormulario = true;
    }

    private void Editar(Cita cita)
    {
        nuevaCita = new Cita
        {
            Id = cita.Id,
            PacienteId = cita.PacienteId,
            Fecha = cita.Fecha,
            Hora = cita.Hora,
            Departamento = cita.Departamento,
            Estado = cita.Estado,
            Observaciones = cita.Observaciones
        };
        mostrarFormulario = true;
    }

    private async Task Guardar()
    {
        bool exito;
        if (nuevaCita.Id > 0)
            exito = await CitasService.ActualizarCita(nuevaCita.Id, nuevaCita);
        else
            exito = await CitasService.CrearCita(nuevaCita);

        if (exito)
        {
            mostrarFormulario = false;
            await CargarDatos();
        }
    }

    private async Task Eliminar(int id)
    {
        if (await CitasService.EliminarCita(id))
            await CargarDatos();
    }
}
