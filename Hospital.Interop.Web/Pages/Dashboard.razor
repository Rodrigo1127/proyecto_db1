@page "/dashboard"
@using Hospital.Interop.Web.Services
@inject NavigationManager Navigation

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-4">
                <i class="fas fa-chart-line"></i> Panel de Control
            </h1>
            <p class="text-muted">Bienvenido al sistema de gestión hospitalaria</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card border-0 bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Total Pacientes</h6>
                            <h2>245</h2>
                            <small>Registrados en el sistema</small>
                        </div>
                        <i class="fas fa-users fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-0 bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Citas Hoy</h6>
                            <h2>12</h2>
                            <small>Programadas para hoy</small>
                        </div>
                        <i class="fas fa-calendar-check fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-0 bg-warning text-dark">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Pruebas Pendientes</h6>
                            <h2>8</h2>
                            <small>Esperando resultados</small>
                        </div>
                        <i class="fas fa-flask fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-0 bg-danger text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Facturas Vencidas</h6>
                            <h2>3</h2>
                            <small>Requieren atención</small>
                        </div>
                        <i class="fas fa-exclamation-triangle fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header bg-light">
                    <h5>Próximas Citas</h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <a href="#" class="list-group-item list-group-item-action">
                            <div class="d-flex justify-content-between">
                                <h6>Juan Pérez - Cardiología</h6>
                                <span class="badge bg-success">Confirmada</span>
                            </div>
                            <small class="text-muted">10:30 AM - 15/01/2024</small>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action">
                            <div class="d-flex justify-content-between">
                                <h6>María García - Pediatría</h6>
                                <span class="badge bg-warning">Pendiente</span>
                            </div>
                            <small class="text-muted">02:00 PM - 16/01/2024</small>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action">
                            <div class="d-flex justify-content-between">
                                <h6>Carlos López - Oftalmología</h6>
                                <span class="badge bg-info">Reprogramada</span>
                            </div>
                            <small class="text-muted">11:00 AM - 17/01/2024</small>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header bg-light">
                    <h5>Actividad Reciente</h5>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        <div class="timeline-item mb-3">
                            <div class="d-flex">
                                <div class="flex-shrink-0">
                                    <i class="fas fa-user-plus text-success"></i>
                                </div>
                                <div class="flex-grow-1 ms-2">
                                    <h6 class="mb-0">Nuevo paciente registrado</h6>
                                    <small class="text-muted">Hace 2 horas</small>
                                </div>
                            </div>
                        </div>
                        <div class="timeline-item mb-3">
                            <div class="d-flex">
                                <div class="flex-shrink-0">
                                    <i class="fas fa-calendar-check text-info"></i>
                                </div>
                                <div class="flex-grow-1 ms-2">
                                    <h6 class="mb-0">Cita confirmada</h6>
                                    <small class="text-muted">Hace 5 horas</small>
                                </div>
                            </div>
                        </div>
                        <div class="timeline-item">
                            <div class="d-flex">
                                <div class="flex-shrink-0">
                                    <i class="fas fa-file-invoice text-warning"></i>
                                </div>
                                <div class="flex-grow-1 ms-2">
                                    <h6 class="mb-0">Factura generada</h6>
                                    <small class="text-muted">Hace 1 día</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-light">
                    <h5>Accesos Rápidos</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-2 mb-2">
                            <button class="btn btn-outline-primary w-100" @onclick="@((Action)(() => Navigation.NavigateTo("/pacientes")))">
                                <i class="fas fa-users"></i><br />
                                Pacientes
                            </button>
                        </div>
                        <div class="col-md-2 mb-2">
                            <button class="btn btn-outline-success w-100" @onclick="@((Action)(() => Navigation.NavigateTo("/citas")))">
                                <i class="fas fa-calendar-alt"></i><br />
                                Citas
                            </button>
                        </div>
                        <div class="col-md-2 mb-2">
                            <button class="btn btn-outline-info w-100" @onclick="@((Action)(() => Navigation.NavigateTo("/laboratorio")))">
                                <i class="fas fa-flask"></i><br />
                                Laboratorio
                            </button>
                        </div>
                        <div class="col-md-2 mb-2">
                            <button class="btn btn-outline-warning w-100" @onclick="@((Action)(() => Navigation.NavigateTo("/facturacion")))">
                                <i class="fas fa-receipt"></i><br />
                                Facturación
                            </button>
                        </div>
                        <div class="col-md-2 mb-2">
                            <button class="btn btn-outline-secondary w-100" @onclick="@((Action)(() => Navigation.NavigateTo("/departamentos")))">
                                <i class="fas fa-hospital"></i><br />
                                Departamentos
                            </button>
                        </div>
                        <div class="col-md-2 mb-2">
                            <button class="btn btn-outline-dark w-100" @onclick="@((Action)(() => Navigation.NavigateTo("/reportes")))">
                                <i class="fas fa-chart-bar"></i><br />
                                Reportes
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .timeline {
        position: relative;
        padding-left: 0;
    }

    .timeline-item {
        padding-left: 0;
        border-left: none;
    }

    .timeline-item .fa-user-plus::before,
    .timeline-item .fa-calendar-check::before,
    .timeline-item .fa-file-invoice::before {
        width: 30px;
        height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #f8f9fa;
        border-radius: 50%;
        font-size: 16px;
    }
</style>

@code {
    protected override void OnInitialized()
    {
    }
}
