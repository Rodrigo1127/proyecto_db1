@page "/dashboard"
@inject NavigationManager Navigation

<PageTitle>Dashboard - Hospital Interop</PageTitle>

<div class="row mb-4">
    <div class="col-12">
        <h2 class="fw-bold"><i class="fas fa-th-large text-primary me-2"></i>Panel de Control</h2>
        <p class="text-muted">Resumen operativo y métricas en tiempo real del hospital.</p>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Stats Cards -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small fw-bold text-uppercase mb-1">Pacientes Totales</p>
                        <h2 class="fw-bold mb-0">1,284</h2>
                    </div>
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3">
                        <i class="fas fa-user-friends fa-lg"></i>
                    </div>
                </div>
                <div class="mt-3 small">
                    <span class="text-success fw-bold"><i class="fas fa-arrow-up"></i> 12%</span>
                    <span class="text-muted">vs mes pasado</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small fw-bold text-uppercase mb-1">Citas para Hoy</p>
                        <h2 class="fw-bold mb-0">42</h2>
                    </div>
                    <div class="bg-success bg-opacity-10 text-success rounded-circle p-3">
                        <i class="fas fa-calendar-check fa-lg"></i>
                    </div>
                </div>
                <div class="mt-3 small">
                    <span class="text-success fw-bold"><i class="fas fa-check"></i> 15</span>
                    <span class="text-muted">Completadas</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small fw-bold text-uppercase mb-1">Pruebas Pend.</p>
                        <h2 class="fw-bold mb-0">18</h2>
                    </div>
                    <div class="bg-info bg-opacity-10 text-info rounded-circle p-3">
                        <i class="fas fa-vial fa-lg"></i>
                    </div>
                </div>
                <div class="mt-3 small">
                    <span class="text-danger fw-bold"><i class="fas fa-clock"></i> 3</span>
                    <span class="text-muted">Urgentes</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small fw-bold text-uppercase mb-1">Recaudación</p>
                        <h2 class="fw-bold mb-0">$12.4k</h2>
                    </div>
                    <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3">
                        <i class="fas fa-dollar-sign fa-lg"></i>
                    </div>
                </div>
                <div class="mt-3 small">
                    <span class="text-success fw-bold"><i class="fas fa-arrow-up"></i> 8%</span>
                    <span class="text-muted">Crecimiento semanal</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="mb-0 fw-bold">Próximas Citas Médicas</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Paciente</th>
                                <th>Especialidad</th>
                                <th>Hora</th>
                                <th>Estado</th>
                                <th class="text-end pe-4">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-secondary bg-opacity-10 text-secondary rounded-circle p-2 small">JP</div>
                                        <div class="fw-bold">Juan Pérez</div>
                                    </div>
                                </td>
                                <td>Cardiología</td>
                                <td>10:30 AM</td>
                                <td><span class="badge bg-success-subtle text-success">Confirmada</span></td>
                                <td class="text-end pe-4"><button class="btn btn-sm btn-light">Ver</button></td>
                            </tr>
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-secondary bg-opacity-10 text-secondary rounded-circle p-2 small">MG</div>
                                        <div class="fw-bold">María García</div>
                                    </div>
                                </td>
                                <td>Pediatría</td>
                                <td>11:15 AM</td>
                                <td><span class="badge bg-warning-subtle text-warning">Pendiente</span></td>
                                <td class="text-end pe-4"><button class="btn btn-sm btn-light">Ver</button></td>
                            </tr>
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-secondary bg-opacity-10 text-secondary rounded-circle p-2 small">CL</div>
                                        <div class="fw-bold">Carlos López</div>
                                    </div>
                                </td>
                                <td>Oftalmología</td>
                                <td>12:00 PM</td>
                                <td><span class="badge bg-danger-subtle text-danger">Urgente</span></td>
                                <td class="text-end pe-4"><button class="btn btn-sm btn-light">Ver</button></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="mb-0 fw-bold">Actividad Reciente</h5>
            </div>
            <div class="card-body">
                <div class="d-flex flex-column gap-4">
                    <div class="d-flex gap-3">
                        <div class="bg-success-subtle text-success rounded-circle p-2 h-100 mt-1">
                            <i class="fas fa-plus fa-xs"></i>
                        </div>
                        <div>
                            <div class="fw-bold small">Nuevo Paciente</div>
                            <div class="text-muted smaller">Ricardo Morales ha sido registrado.</div>
                            <div class="smaller text-primary mt-1">Hace 15 min</div>
                        </div>
                    </div>
                    <div class="d-flex gap-3">
                        <div class="bg-primary-subtle text-primary rounded-circle p-2 h-100 mt-1">
                            <i class="fas fa-check fa-xs"></i>
                        </div>
                        <div>
                            <div class="fw-bold small">Cita Completada</div>
                            <div class="text-muted smaller">Dra. Smith finalizó cita con Ana Luz.</div>
                            <div class="smaller text-primary mt-1">Hace 45 min</div>
                        </div>
                    </div>
                    <div class="d-flex gap-3">
                        <div class="bg-warning-subtle text-warning rounded-circle p-2 h-100 mt-1">
                            <i class="fas fa-file-invoice-dollar fa-xs"></i>
                        </div>
                        <div>
                            <div class="fw-bold small">Pago Recibido</div>
                            <div class="text-muted smaller">Factura #4029 pagada exitosamente.</div>
                            <div class="smaller text-primary mt-1">Hace 2 horas</div>
                        </div>
                    </div>
                </div>
                <button class="btn btn-outline-primary btn-sm w-100 mt-4">Ver toda la actividad</button>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-success-subtle { background-color: #d1fae5; }
    .bg-warning-subtle { background-color: #fef3c7; }
    .bg-danger-subtle { background-color: #fee2e2; }
    .bg-primary-subtle { background-color: #e0f2fe; }
    .smaller { font-size: 0.75rem; }
</style>

@code {
}
