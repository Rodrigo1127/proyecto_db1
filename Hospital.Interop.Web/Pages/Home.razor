@page "/"
@inject PacienteService PacienteService
@inject CitasService CitasService
@using Hospital.Interop.Web.Models

<PageTitle>Dashboard - Hospital Interop</PageTitle>

<div class="animate-fade-in">
    <div class="row mb-5">
        <div class="col-12">
            <h1 class="display-5 fw-bold mb-2">Bienvenido, Dr. Admin</h1>
            <p class="text-secondary lead">Aquí tienes el resumen operativo del hospital para hoy.</p>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card stat-card h-100 p-4 border-0 shadow-sm" style="border-bottom: 4px solid #10b981 !important;">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="bg-success bg-opacity-10 text-success p-3 rounded-3">
                        <i class="fas fa-users fa-2x"></i>
                    </div>
                    <span class="badge bg-success-subtle text-success">+12%</span>
                </div>
                <h3 class="fw-bold mb-1">1,284</h3>
                <p class="text-muted mb-0 small text-uppercase fw-semibold">Pacientes Totales</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card h-100 p-4 border-0 shadow-sm" style="border-bottom: 4px solid #3b82f6 !important;">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3">
                        <i class="fas fa-calendar-check fa-2x"></i>
                    </div>
                    <span class="badge bg-primary-subtle text-primary">Hoy</span>
                </div>
                <h3 class="fw-bold mb-1">42</h3>
                <p class="text-muted mb-0 small text-uppercase fw-semibold">Citas Programadas</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card h-100 p-4 border-0 shadow-sm" style="border-bottom: 4px solid #f59e0b !important;">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-3">
                        <i class="fas fa-microscope fa-2x"></i>
                    </div>
                    <span class="badge bg-warning-subtle text-warning">Pendiente</span>
                </div>
                <h3 class="fw-bold mb-1">18</h3>
                <p class="text-muted mb-0 small text-uppercase fw-semibold">Pruebas de Laboratorio</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card h-100 p-4 border-0 shadow-sm" style="border-bottom: 4px solid #ef4444 !important;">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="bg-danger bg-opacity-10 text-danger p-3 rounded-3">
                        <i class="fas fa-file-invoice-dollar fa-2x"></i>
                    </div>
                    <span class="badge bg-danger-subtle text-danger">Facturas</span>
                </div>
                <h3 class="fw-bold mb-1">$24,500</h3>
                <p class="text-muted mb-0 small text-uppercase fw-semibold">Ingresos del Mes</p>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Recent Appointments -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold">Próximas Citas</h5>
                    <a href="/citas" class="btn btn-sm btn-light text-primary fw-bold">Ver todas</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Paciente</th>
                                    <th>Departamento</th>
                                    <th>Hora</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (citasRecientes == null)
                                {
                                    <tr><td colspan="4" class="text-center py-4 text-muted">Cargando citas...</td></tr>
                                }
                                else if (!citasRecientes.Any())
                                {
                                    <tr><td colspan="4" class="text-center py-4 text-muted">No hay citas para hoy</td></tr>
                                }
                                else
                                {
                                    @foreach (var cita in citasRecientes.Take(5))
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-bold">@cita.PacienteId</div>
                                                <div class="small text-muted">ID Cita: @cita.Id</div>
                                            </td>
                                            <td><span class="badge bg-light text-dark border">@cita.Departamento</span></td>
                                            <td>@cita.Hora</td>
                                            <td>
                                                <span class="badge @(cita.Estado == "Confirmada" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning")">
                                                    @cita.Estado
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Access -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100 bg-secondary text-white overflow-hidden">
                <div class="card-body p-4 position-relative">
                    <div class="position-absolute top-0 end-0 p-3 opacity-25">
                        <i class="fas fa-hospital-symbol fa-6x"></i>
                    </div>
                    <h4 class="fw-bold mb-4">Acciones Rápidas</h4>
                    <div class="d-grid gap-3">
                        <a href="/pacientes" class="btn btn-light text-start d-flex align-items-center gap-3">
                            <i class="fas fa-user-plus text-primary"></i> Registrar Paciente
                        </a>
                        <a href="/citas" class="btn btn-light text-start d-flex align-items-center gap-3">
                            <i class="fas fa-calendar-plus text-primary"></i> Programar Cita
                        </a>
                        <a href="/facturacion" class="btn btn-light text-start d-flex align-items-center gap-3">
                            <i class="fas fa-receipt text-primary"></i> Generar Factura
                        </a>
                        <a href="/laboratorio" class="btn btn-light text-start d-flex align-items-center gap-3">
                            <i class="fas fa-vials text-primary"></i> Ver Laboratorio
                        </a>
                    </div>
                    <div class="mt-5 pt-4">
                        <div class="small text-white-50">Sistema Interoperable Hospitalario</div>
                        <div class="fw-bold">v1.2.0 Professional Edition</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-success-subtle { background-color: #dcfce7; color: #166534; }
    .bg-primary-subtle { background-color: #dbeafe; color: #1e40af; }
    .bg-warning-subtle { background-color: #fef3c7; color: #92400e; }
    .bg-danger-subtle { background-color: #fee2e2; color: #991b1b; }
</style>

@code {
    private List<Cita> citasRecientes;

    protected override async Task OnInitializedAsync()
    {
        try {
            citasRecientes = await CitasService.ObtenerTodasCitas();
        } catch {
            citasRecientes = new List<Cita>();
        }
    }
}
