@page "/paciente-admin"
@inject PacienteService PacienteService
@using Hospital.Interop.Web.Models
@using Hospital.Interop.Web.Services

<PageTitle>Consultar Paciente (Admin)</PageTitle>

<div class="container mt-5">
    <h1>Consultar Paciente - Vista Administrativa</h1>

    <div class="alert alert-warning" role="alert">
        <strong>?? Acceso Restringido:</strong> Esta página muestra información sensible incluyendo el ID del paciente.
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <div class="mb-3">
                <label for="adminKey" class="form-label">Clave Administrativa:</label>
                <input type="password" id="adminKey" class="form-control" 
                       @bind="adminKey" placeholder="Ingrese su clave admin" />
            </div>

            <div class="mb-3">
                <label for="pacienteId" class="form-label">ID del Paciente:</label>
                <div class="input-group">
                    <input type="number" id="pacienteId" class="form-control" 
                           @bind="pacienteIdInput" placeholder="Ingrese el ID" />
                    <button class="btn btn-danger" @onclick="BuscarPaciente">
                        @if (cargando)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Cargando...</span>
                        }
                        else
                        {
                            <span>Buscar (Admin)</span>
                        }
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @mensaje
                    <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @error
                    <button type="button" class="btn-close" @onclick="() => error = string.Empty"></button>
                </div>
            }
        </div>
    </div>

    @if (paciente != null)
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card border-danger">
                    <div class="card-header bg-danger text-white">
                        <h5>Datos del Paciente (Confidencial)</h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info">
                            <strong>ID Paciente (Confidencial):</strong> <code>@paciente.PacienteId</code>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong>Nombre:</strong>
                                <p>@paciente.Nombre</p>
                            </div>
                            <div class="col-md-6">
                                <strong>Documento:</strong>
                                <p>@paciente.Documento</p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong>Teléfono:</strong>
                                <p>@paciente.Telefono</p>
                            </div>
                            <div class="col-md-6">
                                <strong>Email:</strong>
                                <p>@paciente.Email</p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong>Fecha de Nacimiento:</strong>
                                <p>@(paciente.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "No disponible")</p>
                            </div>
                            <div class="col-md-6">
                                <strong>Género:</strong>
                                <p>@(paciente.Genero ?? "No especificado")</p>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <strong>Dirección:</strong>
                                <p>@paciente.Direccion</p>
                            </div>
                        </div>

                        <hr />
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button class="btn btn-warning" @onclick="CopiarId">
                                ?? Copiar ID al Portapapeles
                            </button>
                            <button class="btn btn-secondary" @onclick="Limpiar">
                                ?? Nueva Búsqueda
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string adminKey = string.Empty;
    private string pacienteIdInput = string.Empty;
    private PacienteDTOConId? paciente;
    private string mensaje = string.Empty;
    private string error = string.Empty;
    private bool cargando = false;

    private async Task BuscarPaciente()
    {
        if (string.IsNullOrWhiteSpace(adminKey))
        {
            error = "Debe ingresar su clave administrativa";
            return;
        }

        if (string.IsNullOrWhiteSpace(pacienteIdInput) || !int.TryParse(pacienteIdInput, out var id))
        {
            error = "Por favor ingrese un ID válido";
            return;
        }

        cargando = true;
        error = string.Empty;
        mensaje = string.Empty;

        try
        {
            paciente = await PacienteService.ObtenerPacienteConId(id, adminKey);

            if (paciente == null)
            {
                error = $"No se encontró un paciente con el ID {id} o clave administrativa inválida";
                paciente = null;
            }
            else
            {
                mensaje = "? Paciente encontrado correctamente (Acceso Administrativo)";
            }
        }
        catch (Exception ex)
        {
            error = $"Error al buscar el paciente: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void CopiarId()
    {
        if (paciente != null)
        {
            // En Blazor WASM, usarías JavaScript interop para copiar al portapapeles
            mensaje = $"ID copiado: {paciente.PacienteId}";
        }
    }

    private void Limpiar()
    {
        paciente = null;
        pacienteIdInput = string.Empty;
        mensaje = string.Empty;
        error = string.Empty;
    }
}
