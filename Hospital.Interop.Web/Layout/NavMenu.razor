<div class="sidebar d-flex flex-column h-100">
    <div class="navbar-brand py-4 px-4 mb-3">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-primary p-2 rounded-3 shadow-lg">
                <i class="fas fa-hospital-user text-white"></i>
            </div>
            <span class="fw-bold tracking-tight text-white h5 mb-0">HOSPITAL<br><small class="fw-normal opacity-50">INTEROP</small></span>
        </div>
    </div>

    <div class="flex-grow-1 overflow-auto">
        <nav class="nav flex-column">
            <div class="px-4 mb-2 text-muted smaller text-uppercase fw-bold opacity-50" style="letter-spacing: 2px;">Principal</div>
            
            <div class="nav-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <i class="fas fa-grid-2"></i> <i class="fas fa-th-large"></i> Dashboard
                </NavLink>
            </div>

            <div class="px-4 mt-4 mb-2 text-muted smaller text-uppercase fw-bold opacity-50" style="letter-spacing: 2px;">Gestión Médica</div>
            
            <div class="nav-item">
                <NavLink class="nav-link" href="pacientes">
                    <i class="fas fa-user-injured"></i> Pacientes
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="citas">
                    <i class="fas fa-calendar-check"></i> Citas Médicas
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="laboratorio">
                    <i class="fas fa-microscope"></i> Laboratorio
                </NavLink>
            </div>

            <div class="px-4 mt-4 mb-2 text-muted smaller text-uppercase fw-bold opacity-50" style="letter-spacing: 2px;">Administración</div>

            <div class="nav-item">
                <NavLink class="nav-link" href="facturacion">
                    <i class="fas fa-file-invoice-dollar"></i> Facturación
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="departamentos">
                    <i class="fas fa-clinic-medical"></i> Departamentos
                </NavLink>
            </div>

            <div class="px-4 mt-4 mb-2 text-muted smaller text-uppercase fw-bold opacity-50" style="letter-spacing: 2px;">Acceso Rápido</div>

            <div class="nav-item">
                <NavLink class="nav-link" href="paciente">
                    <i class="fas fa-search"></i> Portal Público
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="paciente-admin">
                    <i class="fas fa-user-shield"></i> Área Admin
                </NavLink>
            </div>
        </nav>
    </div>

    <div class="p-4 border-top border-secondary border-opacity-25 mt-auto">
        <div class="d-flex align-items-center gap-3">
            <div class="status-dot animate-pulse"></div>
            <div class="text-white-50 small">Sistema Activo</div>
        </div>
        <button class="btn btn-outline-light btn-sm w-100 mt-3 border-opacity-25" @onclick="OpenSwagger">
            <i class="fas fa-code me-2"></i>API Swagger
        </button>
    </div>
</div>

<style>
    .smaller { font-size: 0.65rem; }
    .status-dot {
        width: 8px;
        height: 8px;
        background-color: #10b981;
        border-radius: 50%;
        box-shadow: 0 0 0 rgba(16, 185, 129, 0.4);
    }
    
    .animate-pulse {
        animation: pulse 2s infinite;
    }
    
    @@keyframes pulse {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }
</style>

@inject HttpClient Http
@inject IJSRuntime JS

@code {
    private async Task OpenSwagger()
    {
        var baseUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? "http://localhost:5225";
        var swaggerUrl = $"{baseUrl}/swagger/index.html";
        await JS.InvokeVoidAsync("window.open", swaggerUrl, "_blank");
    }
}
